# Import this snippet inside the existing Dorham site block before its app handler.
# Copy only artifacts/v<version>/downloads/* into /var/lib/dorham-downloads/.
# Publish the immutable version directory first; replace latest.json last.
(dorham_downloads) {
    handle_path /downloads/* {
        root * /var/lib/dorham-downloads
        # Legacy Windows apps fetch latest.json in the main process without an
        # Origin header. Android and old renderer menus retain the unchanged
        # schema-1 manifest; new clients use explicit platform metadata.
        @legacyWindows {
            path /latest.json
            header User-Agent *Electron/*
            not header Origin *
        }
        rewrite @legacyWindows /windows.json
        @metadata path /latest.json /windows.json /android.json /releases.json
        header @metadata Cache-Control "no-store"
        header @metadata Vary "User-Agent, Origin"
        @packages path_regexp packages ^/[0-9]+\.[0-9]+\.[0-9]+/[^/]+$
        header @packages Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "*"
        header X-Content-Type-Options "nosniff"
        file_server
    }
}
