<UserControl x:Class="Dorham.Monitor.AdminPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Dorham.Monitor">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <TextBlock x:Name="Notice" Text="Sign in with your Dorham global administrator account. This is separate from the SSH connection." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,14">
      <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <ScrollViewer x:Name="LoginView" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="530" HorizontalAlignment="Left">
        <Border Style="{StaticResource Card}"><StackPanel>
          <TextBlock Text="Administrator sign-in" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,18" />
          <TextBlock Text="Dorham HTTPS address" /><TextBox x:Name="Endpoint" Text="https://dorhamapp.ir" AutomationProperties.Name="Dorham HTTPS address" />
          <TextBlock Text="Administrator username" /><TextBox x:Name="Username" AutomationProperties.Name="Administrator username" />
          <TextBlock Text="Administrator password" /><PasswordBox x:Name="LoginPassword" AutomationProperties.Name="Administrator password" />
          <Button x:Name="SignInButton" Content="Sign in" Click="SignIn" HorizontalAlignment="Left" Background="{StaticResource Accent}" Foreground="#11251D" />
          <TextBlock Text="Credentials stay in memory for this session. SSH monitoring continues independently. Native administrator sessions expire after 15 minutes." TextWrapping="Wrap" Style="{StaticResource MutedText}" LineHeight="19" Margin="0,16,0,0" />
        </StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
    <Grid x:Name="UsersView" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="FeaturesButton" Content="Server tools" Click="OpenFeatures" Margin="0,0,8,0" ToolTip="Feature policies, communities, library, speech, announcements and audit history" /><Button Content="Refresh" Click="Refresh" Margin="0,0,8,0" /><Button Content="Sign out" Click="SignOut" /></StackPanel>
        <TextBlock x:Name="SessionLabel" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <TextBlock x:Name="CapabilityNotice" Grid.Row="1" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12" />
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.68*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="14"><DockPanel>
          <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="UserCount" FontSize="15" FontWeight="SemiBold" /><TextBox x:Name="Search" AutomationProperties.Name="Search users" TextChanged="FilterUsers" ToolTip="Filter by username or display name" /><TextBlock Text="Search by username or display name" Style="{StaticResource MutedText}" Margin="0,-8,0,10" /></StackPanel>
          <ListBox x:Name="UserList" SelectionChanged="SelectUser" Background="Transparent" Foreground="#F2F4FA" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,0,0,5" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#294037" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#85E6BE" /><Setter TargetName="Row" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18"><ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock x:Name="SelectedName" Text="Select an account" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SelectedDetail" Text="Choose a user to manage their access." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18" />
          <local:AccountAccessPanel x:Name="AccessEditor" Visibility="Collapsed" />
          <Expander x:Name="AccountActions" Header="Account actions" Visibility="Collapsed" Margin="0,16,0,0">
          <StackPanel Margin="0,10,0,0">
          <UniformGrid Columns="2"><Button x:Name="BanButton" Content="Ban" Click="Ban" Margin="0,0,6,8" /><Button x:Name="UnbanButton" Content="Unban" Click="Unban" Margin="0,0,0,8" /><Button x:Name="RevokeButton" Content="Sign out devices" Click="Revoke" Margin="0,0,6,8" /><Button x:Name="ResetButton" Content="Generate password" Click="ResetPassword" Margin="0,0,0,8" /><Button x:Name="SetButton" Content="Set password" Click="SetPassword" Margin="0,0,6,8" /><Button x:Name="DeleteButton" Content="Delete account" Click="DeleteAccount" Foreground="#F28C98" Margin="0,0,0,8" /></UniformGrid>
          <TextBlock Text="Bans apply to the whole Dorham instance. Administrator accounts are protected. Password changes sign out all devices and require a new password at next login." Style="{StaticResource MutedText}" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,12" />
          <Border x:Name="ActionForm" Visibility="Collapsed" Background="#111620" CornerRadius="10" Padding="14"><StackPanel>
            <TextBlock x:Name="ActionTitle" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="ActionDetail" TextWrapping="Wrap" Style="{StaticResource MutedText}" LineHeight="19" Margin="0,10,0,10" />
            <StackPanel x:Name="PasswordForm" Visibility="Collapsed"><TextBlock Text="New password (8–128 characters)" /><PasswordBox x:Name="NewPassword" MaxLength="128" AutomationProperties.Name="New user password" /><TextBlock Text="Repeat new password" /><PasswordBox x:Name="RepeatPassword" MaxLength="128" AutomationProperties.Name="Repeat new user password" /></StackPanel>
            <StackPanel x:Name="DeleteForm" Visibility="Collapsed"><TextBlock Text="Type the exact username" /><TextBox x:Name="ConfirmUsername" AutomationProperties.Name="Confirm username to delete" /></StackPanel>
            <StackPanel Orientation="Horizontal"><Button x:Name="ConfirmButton" Content="Confirm" Click="ConfirmAction" Margin="0,0,8,0" /><Button Content="Cancel" Click="CancelAction" /></StackPanel>
          </StackPanel></Border>
          <Border x:Name="PasswordResult" Visibility="Collapsed" Background="#192D27" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel><TextBlock Text="Temporary password — shown once" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Reveal to read or select/copy it, then dismiss. It is not saved by the monitor. Clipboard contents are managed by Windows." TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,8" /><TextBox x:Name="GeneratedPassword" IsReadOnly="True" Visibility="Collapsed" AutomationProperties.Name="Generated temporary password" /><StackPanel Orientation="Horizontal"><Button x:Name="RevealButton" Content="Reveal" Click="RevealPassword" Margin="0,0,8,0" /><Button Content="Dismiss" Click="DismissPassword" /></StackPanel></StackPanel></Border>
          </StackPanel>
          </Expander>
        </StackPanel></ScrollViewer></Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
