<Application x:Class="Dorham.Monitor.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Background" Color="#10131A" />
    <SolidColorBrush x:Key="Surface" Color="#191D27" />
    <SolidColorBrush x:Key="Border" Color="#2B303F" />
    <SolidColorBrush x:Key="Muted" Color="#929BAD" />
    <SolidColorBrush x:Key="Accent" Color="#85E6BE" />
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="#F2F4FA" /><Setter Property="Background" Value="{StaticResource Background}" /></Style>
    <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style x:Key="ToolNavigationItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#E6EBF5" /><Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,1" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <Border x:Name="ItemBackground" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#252E3A" /></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="#294037" /><Setter Property="Foreground" Value="{StaticResource Accent}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ItemBackground" Property="BorderBrush" Value="{StaticResource Accent}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#E6EBF5" /><Setter Property="Background" Value="#111620" />
      <Setter Property="BorderBrush" Value="#384254" /><Setter Property="MinHeight" Value="33" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource ToolNavigationItem}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="#111620" BorderBrush="#384254" BorderThickness="1" CornerRadius="6">
                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" Data="M 0,0 L 4,4 L 8,0" Stroke="#B5C0D2" StrokeThickness="1.4" />
              </Border>
            </ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Margin="10,4,29,4" VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
          <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True">
            <Border Background="#191D27" BorderBrush="#384254" BorderThickness="1" CornerRadius="6" Padding="3" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
              <ScrollViewer><ItemsPresenter /></ScrollViewer>
            </Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.83" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="DropDownToggle" Property="Opacity" Value="0.46" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#DCE2EE" /></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource Surface}" /><Setter Property="CornerRadius" Value="14" /><Setter Property="BorderBrush" Value="{StaticResource Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="22" /></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E6EBF5" /><Setter Property="Background" Value="#232937" /><Setter Property="BorderBrush" Value="#353D50" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16,10" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.78" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="#85E6BE" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111620" /><Setter Property="Foreground" Value="#F2F4FA" /><Setter Property="BorderBrush" Value="#384254" /><Setter Property="CaretBrush" Value="#85E6BE" /><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,6,0,15" /></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#111620" /><Setter Property="Foreground" Value="#F2F4FA" /><Setter Property="BorderBrush" Value="#384254" /><Setter Property="CaretBrush" Value="#85E6BE" /><Setter Property="Padding" Value="10" /><Setter Property="Margin" Value="0,6,0,15" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DCE2EE" /><Setter Property="Margin" Value="0,8" /></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="#141821"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" /></Track.DecreaseRepeatButton><Track.Thumb><Thumb Background="#3B4559"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" /></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ProgressBar"><Setter Property="Height" Value="6" /><Setter Property="Foreground" Value="#85E6BE" /><Setter Property="Background" Value="#2B3242" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid ClipToBounds="True"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3" /><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
