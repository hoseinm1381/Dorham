NODE_ENV=development
SERVER_PORT=3001
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3001
# Trust only the known reverse proxy; direct local development leaves this empty.
TRUSTED_PROXIES=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,capacitor://localhost,https://localhost,dorham://app
DATA_DIR=./data
DATABASE_URL=
COOKIE_SECURE=false
# Set a random secret before exposing registration; claim using Settings.
BOOTSTRAP_ADMIN_SECRET=
REGISTRATION_OPEN=true
MAX_USERS=100
MAX_ONLINE_USERS=20
MAX_VOICE_PARTICIPANTS=16
# Three 30fps-eligible shares globally, plus one 15fps first share per extra room.
STANDARD_SHARE_SLOTS=3
# Legacy optional hard ceilings; leave zero for the tiered policy.
MAX_ROOM_SHARES=0
MAX_GLOBAL_SHARES=0
MESSAGE_RETENTION_DAYS=90
MAX_MESSAGES=50000
MAX_DATABASE_MIB=256
MAX_AVATARS_MIB=16
# No implicit public foreign STUN. Configure domestic infrastructure explicitly.
STUN_URLS=
TURN_URLS=
# Use either static credentials or short-lived credentials derived from TURN_SECRET.
TURN_USERNAME=
TURN_PASSWORD=
TURN_SECRET=
# Optional managed provider; leave TURN_URLS empty when using Cloudflare.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
MEDIA_TRANSPORT=mesh
# Combined official-client screen video/audio encoding budget (overhead is extra).
SCREEN_MAX_BITRATE=1500000
SCREEN_MAX_FRAME_RATE=30
LIVEKIT_URL=
# Server-to-server control API, separate from the public client WSS address.
# On the Iranian all-in-one VPS: http://127.0.0.1:7880
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Private signaling-proxy admission key. Required when enabling the admission
# snippet in deployment/Caddyfile.media.example; never give this to clients.
MEDIA_ADMISSION_SECRET=
GUESTS_ENABLED=true
MAX_GUESTS=100
# Dedicated directory; blank uses DATA_DIR/attachments.
ATTACHMENT_DIR=
ATTACHMENT_BUDGET_MIB=2048
UPLOAD_FREE_RESERVE_MIB=2048
UPLOAD_CONCURRENCY=2
UPLOAD_DAILY_SOFT_MIB=512
UPLOAD_DAILY_HARD_MIB=1024
UPLOAD_SMALL_FILE_MIB=2
