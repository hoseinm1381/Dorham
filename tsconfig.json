{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true, "skipLibCheck": true,
    "resolveJsonModule": true, "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": { "@dorham/contracts": ["./packages/contracts/src/index.ts"], "@dorham/media": ["./packages/media/src/index.ts"] }
  },
  "include": ["apps/*/src/**/*.ts", "apps/*/src/**/*.tsx", "packages/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "**/dist", "apps/android/android"]
}
